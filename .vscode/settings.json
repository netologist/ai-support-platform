{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.exclude": {
    "tmp": true
  },
  "go.useLanguageServer": true,
  "go.formatTool": "goimports",
  "go.lintTool": "golangci-lint-v2",
  "go.lintOnSave": "workspace",
  "go.testFlags": [
    "-race",
    "-count=1"
  ],
  "go.testTimeout": "60s",
  "go.testEnvFile": "${workspaceFolder}/.env",
  "go.testExplorer.enable": true,
  "go.testExplorer.packageDisplayMode": "nested",
  "go.testExplorer.showOutput": true,
  "go.toolsManagement.checkForUpdates": "local",
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.schemas": {
    "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": "compose.yaml"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#042440",
    "activityBar.background": "#042440",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#b40b65",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#042440",
    "statusBar.background": "#010910",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#042440",
    "statusBarItem.remoteBackground": "#010910",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#010910",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#01091099",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#010910"
}