{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Launch Current Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Go: Launch Current File",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Go: Attach To Delve",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    }
  ]
}