APP_ENV=local

API_PORT=8080
WORKER_CONCURRENCY=4

POSTGRES_DB=ai_support_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_support_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Use one target per terminal when running Air.
AIR_BUILD_TARGET=.
# Examples:
# AIR_BUILD_TARGET=./cmd/api
# AIR_BUILD_TARGET=./cmd/worker